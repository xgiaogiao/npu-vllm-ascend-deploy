        <mxCell id="a0" value="步骤0 集群探测&#10;连通矩阵/芯片实测/外网能力/冲突检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="a1" value="步骤1 模型确认(硬性gate)&#10;查 vllm-ascend 文档列候选&#10;AskUserQuestion 确认&#10;权重路径必问用户(禁重下)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="a2" value="步骤2 资源规格&#10;芯片细分(950DT/PR)&#10;TP四条件校验&#10;(头数∩档位∩文档∩显存)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="a3" value="步骤3 部署形式&#10;single / multi_node / pd(xPyD)&#10;节点角色分配表确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="a4" value="步骤4 镜像准备&#10;(见决策页4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="a5" value="步骤5 权重校验+产物生成&#10;config.env + 模板脚本&#10;产物自检关卡(Hard/Soft)&#10;权重暂存三级(见页5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="b1" value="步骤6 分发启动(严格顺序)&#10;全部 Prefill → 逐台 /health 200&#10;→ 全部 Decode → 200&#10;→ Proxy 最后" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="630" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="b2" value="步骤7 端到端验证&#10;经 Proxy 请求 + 三侧日志核验&#10;KV 传输确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="470" width="220" height="80" as="geometry" /></mxCell>

  <diagram id="p4" name="4-镜像获取决策">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="i0" value="需要镜像 quay.io/ascend/vllm-ascend:&lt;tag&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="i1" value="用户有内部 SWR?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="160" height="80" as="geometry" /></mxCell>
        <mxCell id="i2" value="节点能直连 quay?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="100" y="290" width="160" height="80" as="geometry" /></mxCell>
        <mxCell id="i3" value="换源拉取 fast_pull2.sh&#10;多源轮换(hlmirror→quay直连)&#10;并发10段+卡速自断+签名刷新&#10;→ 拼 tar → docker load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="270" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="i4" value="入口节点 docker pull&#10;(重试循环, Akamai 时好时坏)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="i5" value="docker save → SFS&#10;→ 内网节点 docker load&#10;(数据面走共享存储,零节点间ssh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="440" width="250" height="80" as="geometry" /></mxCell>
        <mxCell id="i6" value="MA-AscendCloud 模式:&#10;不拉现成镜像 — atelier 基础镜像&#10;+ 版本包现场 build.sh 构建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="40" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="w1" value="⚠ 根因备忘: quay blob 走 Akamai CDN(cdn01),&#10;华为云出口间歇不可达; 内网节点通常无外网" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="580" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="j1" edge="1" parent="1" source="i0" target="i1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="j2" value="有" edge="1" parent="1" source="i1" target="i6" style="strokeColor=#82b366;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="85" /></Array></mxGeometry></mxCell>
        <mxCell id="j3" value="无" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="j4" value="通" edge="1" parent="1" source="i2" target="i4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="j5" value="TLS超时/Retrying卡死" edge="1" parent="1" source="i2" target="i3" style="strokeColor=#b85450;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="j6" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry" /></mxCell>

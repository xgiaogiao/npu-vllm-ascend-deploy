  <diagram id="p3" name="3-MA-AscendCloud高可用模式">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="m0" value="输入: AscendCloud 版本包 + 实践指导文档" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="260" height="60" as="geometry" /></mxCell>
        <mxCell id="m1" value="① 解析指导文档(docx→text)&#10;提取拓扑/Role/端口/参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="m2" value="② 构建业务镜像&#10;atelier基础镜像(SWR拉)&#10;+ IMAGE_TYPE(A2/A3/A5)选子包&#10;+ build.sh(GitCode源 ~70min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="m3" value="③ 宿主机准备(P节点)&#10;1.1TB大页 + tcp_syn_retries=2&#10;清理残留(双杀 vll[m]/VLL[M]::)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="m4" value="④ 容器创建(9个)&#10;P×3 D×1 etcd×3 rs-worker rs-candidate&#10;mooncake-master / 挂载 /data + ATB路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="r1" value="⑤ ETCD×3 (32379/32380)&#10;etcdctl 三点健康" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="r2" value="⑥ RS Candidate(19802 选主)&#10;→ RS Worker(19800 API入口)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="160" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="r3" value="⑦ Mooncake Master(52050/52052)&#10;APC 依赖(选主震荡可绕过)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="270" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="r4" value="⑧ Prefill×3 (rank0先行75s)&#10;TP8×DP本地2 / 端口9081-9082" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="380" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="r5" value="⑨ Decode×1&#10;TP2×DP本地8 / 端口9900-9907" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="r6" value="⑩ 注册 rs_instance_join.py&#10;P(3×2) + D(1×8) → /status 全 running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="r7" value="⑪ 验证: curl :19800 chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="740" y="600" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="k1" value="必打补丁(实测四坑):&#10;1. libldap符号级空壳(openssl三方冲突)&#10;2. HANDSHAKE_TIMEOUT_MINS 5→60&#10;3. ATB lib路径显式 export&#10;4. VLLM_ENGINE_READY_TIMEOUT_S=3600&#10;5. 启动前后台cat预热页缓存" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="740" y="180" width="280" height="140" as="geometry" /></mxCell>
        <mxCell id="q1" edge="1" parent="1" source="m0" target="m1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q2" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q3" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q4" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q5" edge="1" parent="1" source="m4" target="r1" style="edgeStyle=orthogonalEdgeStyle;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="90" /></Array></mxGeometry></mxCell>
        <mxCell id="q6" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q7" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q8" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q9" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell>

# pd.sh 通用 PD 分离配置(xPyD: N 个 Prefill 引擎 + M 个 Decode 引擎 + 1 Proxy)
# 全节点同一份;本机角色由 NODE_IP 在 PREFILL_IPS/DECODE_IPS 中的位置自动判定。
# 取值来源: vllm-ascend 模型适配文档 + 与用户确认的部署方案,禁止凭经验猜。

# ---------- 镜像与模型 ----------
IMAGE=quay.io/ascend/vllm-ascend:<模型文档tag>
MODEL_PATH=/mnt/sfs_turbo/models/GLM-5.3-w4a8-int   # 实测权重位置(W4A8 量化版,按实际确认填)
SERVED_MODEL_NAME=<API model 字段>

# ---------- 拓扑(空格分隔,顺序即 engine_id 顺序) ----------
PREFILL_IPS="<ENTRY-NODE-IP> <NODE1-IP> <NODE2-IP>"
DECODE_IPS="<NODE3-IP>"
PROXY_IP=<ENTRY-NODE-IP>                          # Proxy 与该 Prefill 节点同机(不占 NPU)

# ---------- 本机(留空则自动探测;多网卡/探测不准时必须显式填) ----------
NODE_IP=
NODE_NIC=

# ---------- 端口 ----------
PROXY_PORT=8000
PREFILL_HTTP_PORT=8100                        # 各 Prefill 主机同端口(host 网络,不冲突)
DECODE_HTTP_PORT=8200
KV_PORT_BASE=36100                            # kv_port = KV_PORT_BASE + engine_id*10;本集群 16 卡/节点 → 下限 36000,故默认 36100 起步

# ---------- 并行度与引擎参数(按模型文档的 prefill/decode 示例分别填) ----------
TP_SIZE=8                                     # 引擎张量并行(按实测芯片卡数: A2/950 档位 1/2/4/8,A3 档位 2/4/6/8/16)
PREFILL_DP_LOCAL=1                            # Prefill 引擎节点内 data-parallel(-size 与 -size-local 同值)
DECODE_DP_LOCAL=1                             # Decode 引擎节点内 data-parallel
DTYPE=bfloat16
MAX_MODEL_LEN=131072                          # 文档值(不同芯片/型号可能不同,以文档为准)
GPU_MEM_UTIL=0.85                             # 文档值
MAX_NUM_SEQS=8                                # 文档值
MAX_NUM_BATCHED_TOKENS=8192                   # 文档值(Prefill 侧尤为重要)

# ---------- 附加启动参数(空格分隔;JSON 参数整体加引号放入 EXTRA_ARGS 也支持) ----------
COMMON_EXTRA_ARGS=""                          # 两侧都加,如 --reasoning-parser qwen3
PREFILL_EXTRA_ARGS=""                         # 仅 Prefill,如 --enable-expert-parallel / PP 相关
DECODE_EXTRA_ARGS=""                          # 仅 Decode

# ---------- Mooncake KV 传输 ----------
KV_CONNECTOR=MooncakeHybridConnector          # 或 MooncakeConnectorV1(按镜像内实际可用,见 mooncake-pd-notes.md)

# ---------- 环境 ----------
HCCL_BUFFSIZE=512                             # MoE 大模型按 troubleshooting 调大(GLM-5.3 实测≥1628)
PREFIX=<模型简称>-pd                           # 容器名前缀
WORKDIR_MODE=sfs                              # sfs=工作目录在共享存储(全节点同一份) / local=各节点同路径各一份
